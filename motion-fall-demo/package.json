{
  "name": "motion-fall-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-ready Three.js and cannon-es educational motion-fall demo",
  "type": "module",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "test:dom": "node tests/dom-contract.mjs",
    "test:phase0": "node tests/static-smoke.mjs",
    "test:phase1": "npm run test:phase0 && node tests/phase1-contract.mjs",
    "test:phase2": "npm run test:phase1 && node tests/phase2-contract.mjs",
    "test:phase3": "npm run test:phase2 && node tests/phase3-contract.mjs",
    "test:phase4": "npm run test:phase3 && node tests/phase4-contract.mjs",
    "test:phase5": "npm run test:phase4 && node tests/phase5-contract.mjs",
    "test:phase6": "npm run test:phase5 && node tests/phase6-contract.mjs",
    "test:phase7": "npm run test:phase6 && node tests/phase7-contract.mjs",
    "test:release": "npm run test:phase7 && npm run test:browser && npm run test:pwa && node tests/release-matrix.mjs",
    "test:browser": "node tests/smoke.mjs",
    "test:pwa": "node tests/pwa-offline.mjs",
    "test": "npm run test:phase7"
  },
  "devDependencies": {
    "playwright": "^1.52.0"
  }
}

  "rubric": [
    {
      "id": "identity",
      "criterion": "Each marker resolves to the intended anatomical structure, not a neighboring group."
    },
    {
      "id": "framing",
      "criterion": "Camera framing and orientation presets show the structure without misleading cropping."
    },
    {
      "id": "orientation",
      "criterion": "Anterior/lateral/posterior views match the anatomy's true orientation."
    },
    {
      "id": "occlusion",
      "criterion": "Markers remain readable under layer transparency; hidden targets are not misleadingly implied."
    },
    {
      "id": "contrast",
      "criterion": "Route lines, markers, and labels are separable from source geometry on the dark background."
    },
    {
      "id": "marker-tightness",
      "criterion": "Bounds boxes hug the structure without visually exaggerating its size."
    },
    {
      "id": "route-separation",
      "criterion": "Conceptual routes stay visibly distinct from certified source anatomy."
    },
    {
      "id": "motion",
      "criterion": "Pulse and marker animation follow the teaching state and never imply source-mesh motion."
    },
    {
      "id": "reduced-motion",
      "criterion": "Reduced-motion mode provides an equivalent static or stepped explanation."
    },
    {
      "id": "disclosure",
      "criterion": "Educational and adult-male scope disclosures are visible near the overlay."
    },
    {
      "id": "environment-lighting",
      "criterion": "Environment lighting changes appearance only; color identity and contrast stay readable."
    },
    {
      "id": "ssao-reading",
      "criterion": "Ambient occlusion reads as depth, never as cavities, lesions, or internal anatomy."
    },
    {
      "id": "outline-fidelity",
      "criterion": "Selection outlines hug exact part geometry without implying borders the source lacks."
    },
    {
      "id": "xray-honesty",
      "criterion": "X-ray mode shows loaded layers only; the visualization-not-imaging disclosure is visible in mode."
    },
    {
      "id": "clipping-honesty",
      "criterion": "Section views never imply internal parenchyma; the no-implied-anatomy note is visible."
    },
    {
      "id": "isolation-context",
      "criterion": "Isolated views keep orientation readable and restore cleanly to the full layer state."
    },
    {
      "id": "animation-state-sync",
      "criterion": "Timeline scrubbing keeps chart, markers, captions, and 3D overlay on one deterministic state."
    },
    {
      "id": "tour-framing",
      "criterion": "Guided tour steps frame and caption the intended stage at phone and desktop widths."
    },
    {
      "id": "measurement-labeling",
      "criterion": "Measurement results carry the educational-scale, non-clinical label."
    }
  ],
